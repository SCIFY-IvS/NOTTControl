        <mxCell id="e_cold_press" value="NOT cold/OP&#xa;AND no vacuum" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="cold" target="warm_press">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">

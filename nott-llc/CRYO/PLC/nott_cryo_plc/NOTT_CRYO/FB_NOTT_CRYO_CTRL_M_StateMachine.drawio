        <mxCell id="e_cold_warming" value="WARM_UP command&#xa;warm_up.bPermitStart" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#2f80ed;fontColor=#2f80ed" edge="1" parent="1" source="cold" target="warming_up">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cold_self" value="COOL maintain cold&#xa;if permitted&#xa;or command rejected" style="endArrow=block;html=1;rounded=0;edgeStyle=loopEdgeStyle;strokeColor=#666666;fontColor=#666666" edge="1" parent="1" source="cold" target="cold">
          <mxGeometry x="0.1" y="-22" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_warming_cold" value="stopped/inactive&#xa;AND cold/OP" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="warming_up" target="cold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_warming_vacuum" value="stopped/inactive&#xa;NOT cold/OP&#xa;AND vacuum present" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="warming_up" target="warm_vacuum">
          <mxGeometry relative="1" as="geometry">

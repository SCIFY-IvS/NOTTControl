<mxfile host="app.diagrams.net" modified="2026-07-07T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="nott-cryo-ctrl-state-machine-current" name="FB_NOTT_CRYO_CTRL current M_StateMachine">
    <mxGraphModel dx="1500" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="FB_NOTT_CRYO_CTRL.M_StateMachine - current logic&#xa;Startup/state recovery uses stat.bOP, stat.bCold, stat.bVacuumOK, stat.bVacuum.&#xa;Command acceptance is gated by routine permits from M_SetCmdPermissions()." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="80" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legend&#xa;Solid arrow: automatic state transition&#xa;Blue arrow: permitted command transition&#xa;Red dashed arrow: fault/reset path&#xa;Grey loop: command rejected/ignored or state maintained" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1080" y="20" width="430" height="110" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Power-up / Reset" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="none" value="NONE&#xa;Calls M_GetState()&#xa;10 s startup delay&#xa;Classifies physical state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="145" width="230" height="110" as="geometry" />
        </mxCell>
        <mxCell id="warm_press" value="WARM_PRESS&#xa;Warm and pressurized&#xa;Cooldown OFF&#xa;Warmup OFF&#xa;Evacuation handled by permits&#xa;Rejects COOL/WARM_UP commands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="250" height="135" as="geometry" />
        </mxCell>
        <mxCell id="warm_vacuum" value="WARM_VACUUM&#xa;Warm under vacuum&#xa;Warmup forced OFF unless permitted command accepted&#xa;COOL accepted only if cooldown permit and cooler initialised" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="360" width="280" height="145" as="geometry" />
        </mxCell>
        <mxCell id="cooling_down" value="COOLING_DOWN&#xa;Evacuation kept ON&#xa;Rejects queued COOL/WARM_UP commands&#xa;Leaves on cold/OP, stop, vacuum loss, or cooler inactive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#2f80ed;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1030" y="290" width="285" height="145" as="geometry" />
        </mxCell>
        <mxCell id="cold" value="COLD&#xa;stat.bOP OR stat.bCold&#xa;Evacuation kept ON&#xa;WARM_UP accepted only if warmup permit&#xa;COOL may maintain cold if permitted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1030" y="580" width="285" height="150" as="geometry" />
        </mxCell>
        <mxCell id="warming_up" value="WARMING_UP&#xa;Cooldown forced OFF&#xa;Evacuation kept ON&#xa;Rejects queued COOL/WARM_UP commands&#xa;Classifies state when stopped or routine inactive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="610" y="770" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="error" value="ERROR&#xa;Clears pending command&#xa;Disables cooldown, warmup, evacuation&#xa;RESET returns to NONE for state estimation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;dashed=1" vertex="1" parent="1">
          <mxGeometry x="260" y="770" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="permissions" value="Permission Layer&#xa;M_SetCmdPermissions() computes HMI permits from physical state plus active routines.&#xa;M_CheckForCommands() gates start/stop requests using evac/cool_down/warm_up bPermitStart/bPermitStop.&#xa;Note: command bits and internal enable bits are still shared; separate command request bits remain recommended." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="1470" height="105" as="geometry" />
        </mxCell>
        <mxCell id="e_start_none" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2" edge="1" parent="1" source="start" target="none">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_none_cold" value="After 10 s&#xa;stat.bOP OR stat.bCold" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="none" target="cold">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="395" y="655" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_none_vacuum" value="After 10 s&#xa;NOT cold/OP&#xa;AND (bVacuumOK OR bVacuum)" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="none" target="warm_vacuum">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_none_press" value="After 10 s&#xa;else / unknown" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="none" target="warm_press">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_press_vacuum" value="bVacuumOK OR bVacuum" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="warm_press" target="warm_vacuum">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_press_reject" value="COOL/WARM_UP queued&#xa;rejected and cleared" style="endArrow=block;html=1;rounded=0;edgeStyle=loopEdgeStyle;strokeColor=#666666;fontColor=#666666" edge="1" parent="1" source="warm_press" target="warm_press">
          <mxGeometry x="0.08" y="-25" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_vacuum_press" value="NOT (bVacuumOK OR bVacuum)" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="warm_vacuum" target="warm_press">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="930" y="430" />
              <mxPoint x="930" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_vacuum_cold" value="stat.bOP OR stat.bCold" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="warm_vacuum" target="cold">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="655" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_vacuum_cooling" value="COOL command&#xa;cool_down.bPermitStart&#xa;AND cooler initialised" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#2f80ed;fontColor=#2f80ed" edge="1" parent="1" source="warm_vacuum" target="cooling_down">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_vacuum_warming" value="WARM_UP command&#xa;only if warm_up.bPermitStart" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#2f80ed;fontColor=#2f80ed" edge="1" parent="1" source="warm_vacuum" target="warming_up">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="845" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_vacuum_reject" value="unsupported / not permitted command&#xa;rejected" style="endArrow=block;html=1;rounded=0;edgeStyle=loopEdgeStyle;strokeColor=#666666;fontColor=#666666" edge="1" parent="1" source="warm_vacuum" target="warm_vacuum">
          <mxGeometry x="0.1" y="-22" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cooling_cold" value="stat.bOP OR stat.bCold" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="cooling_down" target="cold">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cooling_press" value="vacuum lost" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="cooling_down" target="warm_press">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1170" y="190" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_cooling_vacuum" value="cooldown stopped&#xa;OR cooler inactive&#xa;and vacuum present" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="cooling_down" target="warm_vacuum">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1170" y="510" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_cooling_reject" value="queued commands rejected" style="endArrow=block;html=1;rounded=0;edgeStyle=loopEdgeStyle;strokeColor=#666666;fontColor=#666666" edge="1" parent="1" source="cooling_down" target="cooling_down">
          <mxGeometry x="0.1" y="-22" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cold_warm_vacuum" value="NOT cold/OP&#xa;AND vacuum present" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="cold" target="warm_vacuum">
          <mxGeometry relative="1" as="geometry">

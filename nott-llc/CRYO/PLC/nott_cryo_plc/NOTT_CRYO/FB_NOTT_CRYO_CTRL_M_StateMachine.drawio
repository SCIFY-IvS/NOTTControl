        <mxCell id="e_warming_press" value="stopped/inactive&#xa;NOT cold/OP&#xa;AND no vacuum" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="warming_up" target="warm_press">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">

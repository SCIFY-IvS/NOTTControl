        <mxCell id="e_warming_reject" value="queued commands rejected" style="endArrow=block;html=1;rounded=0;edgeStyle=loopEdgeStyle;strokeColor=#666666;fontColor=#666666" edge="1" parent="1" source="warming_up" target="warming_up">
          <mxGeometry x="0.1" y="-22" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_error_none" value="ctrl.bReset&#xa;clear enables, restart estimation" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#b85450;fontColor=#b85450" edge="1" parent="1" source="error" target="none">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="390" y="620" />

        <mxCell id="e_any_error" value="external fault path&#xa;currently depends on callers setting ERROR" style="endArrow=block;html=1;rounded=0;dashed=1;strokeColor=#b85450;fontColor=#b85450;edgeStyle=orthogonalEdgeStyle" edge="1" parent="1" source="warm_vacuum" target="error">
          <mxGeometry relative="1" as="geometry">

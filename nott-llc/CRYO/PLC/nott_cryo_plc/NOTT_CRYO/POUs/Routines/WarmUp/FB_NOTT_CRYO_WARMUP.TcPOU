    <Method Name="M_SafetyCheck" Id="{b247bc29-c793-469c-ae87-0665a1511847}">
      <Declaration><![CDATA[METHOD M_SafetyCheck
VAR_INPUT
END_VAR
VAR CONSTANT
	lrPress_WarmAlarmTrip:	LREAL := 10.0E-1;	// [mbar]
	lrPress_WarmAlarmReset:	LREAL := 8.0E-1;	// [mbar], hysteresis reset
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Keep pressure and pump alarm causes separate so clearing one condition
// cannot hide the other.
IF NOT stat.bActive THEN
	stat.bPressureAlarm := FALSE;
ELSIF in_Cryo_Stat.bPressureValid THEN
	IF stat.bPressureAlarm THEN
		IF in_Cryo_Stat.lrPressure_mbar < lrPress_WarmAlarmReset THEN
			stat.bPressureAlarm := FALSE;
		END_IF
	ELSIF in_Cryo_Stat.lrPressure_mbar > lrPress_WarmAlarmTrip THEN
		stat.bPressureAlarm := TRUE;
	END_IF
END_IF

// A pump loss during active warmup disables every heat source and trips the
// routine. The alarm resets only after both pumps recover; restart is manual.
IF stat.bActive
	AND (NOT in_Cryo_Stat.bIsPVPRunning OR NOT in_Cryo_Stat.bIsTMPRunning) THEN
	stat.bPumpAlarm := TRUE;

	nott_heaters.h_detector.M_SetDisable();
	nott_heaters.h_detector_spare.M_SetDisable();
	nott_heaters.h_sidecar.M_SetDisable();
	nott_heaters.h_photonic_chip.M_SetDisable();
	nott_heaters.h_base_plate.M_SetDisable();
	nott_heaters.h_shield.M_SetDisable();

	nott_t_ctrls.tc_detector.M_SetDisable();
	nott_t_ctrls.tc_detector_spare.M_SetDisable();
	nott_t_ctrls.tc_sidecar.M_SetDisable();
	nott_t_ctrls.tc_photonic_chip.M_SetDisable();
	nott_t_ctrls.tc_base_plate.M_SetDisable();
	nott_t_ctrls.tc_shields.M_SetDisable();

	stat.nState := E_NOTT_CRYO_WARMUP_STATE.STOP_WARMUP;
	stat.sErrorText := 'Pump stopped during warmup.';
ELSIF in_Cryo_Stat.bIsPVPRunning AND in_Cryo_Stat.bIsTMPRunning THEN
	stat.bPumpAlarm := FALSE;
END_IF

stat.bAlarm := stat.bPressureAlarm OR stat.bPumpAlarm;
stat.bWarning := stat.bAlarm;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StateMachine" Id="{be2e2661-2a1b-4ffc-b3fc-ed41bcf078a2}">
      <Declaration><![CDATA[METHOD M_StateMachine : BOOL
VAR_INPUT
END_VAR
VAR_IN_OUT
    {attribute 'OPC.UA.DA' := '0'}
    nott_temps   : FB_NOTT_TEMPERATURES;
    {attribute 'OPC.UA.DA' := '0'}
    nott_heaters : FB_NOTT_HEATERS;
    {attribute 'OPC.UA.DA' := '0'}
    nott_t_ctrls : FB_NOTT_TCTRLs;
    {attribute 'OPC.UA.DA' := '0'}
    nott_t_votes : FB_NOTT_VOTERS;
END_VAR
VAR
    lrDetectorTarget : LREAL;
    bDetectorSafe    : BOOL;
    bAllWarm         : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_StateMachine := FALSE;

lrDetectorTarget := nott_temps.out_lrLowestTemp + cfg.lrTemp_Det_OffSet;

bDetectorSafe :=
    nott_temps.out_bLowestTempValid
    AND nott_t_votes.vote_detector.stat.bValid
    AND (nott_t_votes.vote_detector.stat.lrTempK >= lrDetectorTarget);

bAllWarm :=
    nott_t_votes.vote_detector.stat.bValid
    AND nott_t_votes.vote_base_plate.stat.bValid
    AND nott_t_votes.vote_shield.stat.bValid
    AND nott_t_votes.vote_sidecar.stat.bValid
    AND nott_t_votes.vote_photonic_chip.stat.bValid
    AND (nott_t_votes.vote_detector.stat.lrTempK      >= cfg.lrTemp_Det)
    AND (nott_t_votes.vote_base_plate.stat.lrTempK    >= cfg.lrTemp_BasePlate)
    AND (nott_t_votes.vote_shield.stat.lrTempK        >= cfg.lrTemp_Shield)
    AND (nott_t_votes.vote_sidecar.stat.lrTempK       >= cfg.lrTemp_Sidecar)
    AND (nott_t_votes.vote_photonic_chip.stat.lrTempK >= cfg.lrTemp_PhotonicChip); 


CASE stat.nState OF

    E_NOTT_CRYO_WARMUP_STATE.NONE:
        stat.sState  := 'NONE';
        stat.sStatus := 'Undefined state';
        stat.nState  := E_NOTT_CRYO_WARMUP_STATE.OFF;


    E_NOTT_CRYO_WARMUP_STATE.OFF:

        stat.bActive := FALSE;
        stat.sState  := 'OFF';
        stat.sStatus := 'Warm-up OFF';

        out_bPermit_Evacuation_Stop := TRUE;
        out_bPermit_CoolDown        := TRUE;

        trig(CLK := in_bEnable);

        IF trig.Q
		   AND in_Cryo_Stat.bIsPVPRunning
		   AND in_Cryo_Stat.bIsTMPRunning THEN
            stat.bActive := TRUE;
            stat.nState := E_NOTT_CRYO_WARMUP_STATE.START_DETECTOR_PROTECTION;

            out_bPermit_Evacuation_Stop := FALSE;
            out_bPermit_CoolDown        := FALSE;
		ELSIF trig.Q THEN
			stat.sStatus := 'Warm-up start rejected: pumps not ready.';
        END_IF;


    E_NOTT_CRYO_WARMUP_STATE.START_DETECTOR_PROTECTION:

        out_bPermit_Evacuation_Stop := FALSE;
        out_bPermit_CoolDown        := FALSE;

        nott_heaters.h_detector.M_SetEnable();
        nott_heaters.h_detector_spare.M_SetEnable();

        nott_t_ctrls.tc_detector.M_SetEnable();
        nott_t_ctrls.tc_detector_spare.M_SetEnable();

        nott_t_ctrls.tc_detector.M_Set_SetPoint(
            m_eSetpointType    := E_METIS_CTRL_SETPOINT_SWITCH.FIXED,
            m_lrFixedSetpoint  := nott_temps.out_lrLowestTemp,
            m_lrSetpointOffset := cfg.lrTemp_Det_OffSet,
            m_pSetpointTemp    := nott_temps.M_SetTemperatureSensor(0)
        );

        nott_t_ctrls.tc_detector_spare.M_Set_SetPoint(
            m_eSetpointType    := E_METIS_CTRL_SETPOINT_SWITCH.FIXED,
            m_lrFixedSetpoint  := nott_temps.out_lrLowestTemp,
            m_lrSetpointOffset := cfg.lrTemp_Det_OffSet,
            m_pSetpointTemp    := nott_temps.M_SetTemperatureSensor(0)
        );

        stat.sState  := 'Detector protection';
        stat.sStatus := 'Waiting until detector is safely above lowest cryostat temperature';

        stat.nState := E_NOTT_CRYO_WARMUP_STATE.WAIT_DETECTOR_SAFE;


    E_NOTT_CRYO_WARMUP_STATE.WAIT_DETECTOR_SAFE:

        out_bPermit_Evacuation_Stop := FALSE;
        out_bPermit_CoolDown        := FALSE;

        // Keep detector protection active while waiting
        nott_t_ctrls.tc_detector.M_Set_SetPoint(
            m_eSetpointType    := E_METIS_CTRL_SETPOINT_SWITCH.FIXED,
            m_lrFixedSetpoint  := nott_temps.out_lrLowestTemp,
            m_lrSetpointOffset := cfg.lrTemp_Det_OffSet,
            m_pSetpointTemp    := nott_temps.M_SetTemperatureSensor(0)
        );

        nott_t_ctrls.tc_detector_spare.M_Set_SetPoint(
            m_eSetpointType    := E_METIS_CTRL_SETPOINT_SWITCH.FIXED,
            m_lrFixedSetpoint  := nott_temps.out_lrLowestTemp,
            m_lrSetpointOffset := cfg.lrTemp_Det_OffSet,
            m_pSetpointTemp    := nott_temps.M_SetTemperatureSensor(0)
        );

        IF NOT in_bEnable THEN
            stat.nState := E_NOTT_CRYO_WARMUP_STATE.STOP_WARMUP;
        ELSIF bDetectorSafe THEN
            stat.nState := E_NOTT_CRYO_WARMUP_STATE.START_WARMUP;
        ELSE
            stat.sStatus := 'Detector protection active...';
        END_IF;


    E_NOTT_CRYO_WARMUP_STATE.START_WARMUP:

        out_bPermit_Evacuation_Stop := FALSE;
        out_bPermit_CoolDown        := FALSE;

        // Enable remaining heaters
        nott_heaters.h_sidecar.M_SetEnable();
        nott_heaters.h_photonic_chip.M_SetEnable();
        nott_heaters.h_base_plate.M_SetEnable();
        nott_heaters.h_shield.M_SetEnable();

        // Enable remaining temperature controls
        nott_t_ctrls.tc_sidecar.M_SetEnable();
        nott_t_ctrls.tc_photonic_chip.M_SetEnable();
        nott_t_ctrls.tc_base_plate.M_SetEnable();
        nott_t_ctrls.tc_shields.M_SetEnable();

        // Set warm-up setpoints
        nott_t_ctrls.tc_detector.M_Set_SetPoint(
            m_eSetpointType    := E_METIS_CTRL_SETPOINT_SWITCH.FIXED,
            m_lrFixedSetpoint  := cfg.lrTemp_Det,
            m_lrSetpointOffset := 0.0,
            m_pSetpointTemp    := nott_temps.M_SetTemperatureSensor(0)
        );

        nott_t_ctrls.tc_detector_spare.M_Set_SetPoint(
            m_eSetpointType    := E_METIS_CTRL_SETPOINT_SWITCH.FIXED,
            m_lrFixedSetpoint  := cfg.lrTemp_Det,
            m_lrSetpointOffset := 0.0,
            m_pSetpointTemp    := nott_temps.M_SetTemperatureSensor(0)
        );

        nott_t_ctrls.tc_sidecar.M_Set_SetPoint(
            m_eSetpointType    := E_METIS_CTRL_SETPOINT_SWITCH.FIXED,
            m_lrFixedSetpoint  := cfg.lrTemp_Sidecar,
            m_lrSetpointOffset := 0.0,
            m_pSetpointTemp    := nott_temps.M_SetTemperatureSensor(0)
        );

        nott_t_ctrls.tc_photonic_chip.M_Set_SetPoint(
            m_eSetpointType    := E_METIS_CTRL_SETPOINT_SWITCH.FIXED,
            m_lrFixedSetpoint  := cfg.lrTemp_PhotonicChip, 
            m_lrSetpointOffset := 0.0,
            m_pSetpointTemp    := nott_temps.M_SetTemperatureSensor(0)
        );

        nott_t_ctrls.tc_base_plate.M_Set_SetPoint(
            m_eSetpointType    := E_METIS_CTRL_SETPOINT_SWITCH.FIXED,
            m_lrFixedSetpoint  := cfg.lrTemp_BasePlate,
            m_lrSetpointOffset := 0.0,
            m_pSetpointTemp    := nott_temps.M_SetTemperatureSensor(0)
        );

        nott_t_ctrls.tc_shields.M_Set_SetPoint(
            m_eSetpointType    := E_METIS_CTRL_SETPOINT_SWITCH.FIXED,
            m_lrFixedSetpoint  := cfg.lrTemp_Shield,
            m_lrSetpointOffset := 0.0,
            m_pSetpointTemp    := nott_temps.M_SetTemperatureSensor(0)
        );

        stat.sState  := 'WARMING UP';
        stat.sStatus := 'Warm-up heaters enabled';

        stat.nState := E_NOTT_CRYO_WARMUP_STATE.WARMING_UP;


    E_NOTT_CRYO_WARMUP_STATE.WARMING_UP:

        out_bPermit_Evacuation_Stop := FALSE;
        out_bPermit_CoolDown        := FALSE;

        IF NOT in_bEnable THEN
            stat.nState := E_NOTT_CRYO_WARMUP_STATE.STOP_WARMUP;

        ELSIF nott_temps.out_bHighestTempValid
              AND (nott_temps.out_lrHighestTemp > cfg.lrTemp_HighLimit) THEN

            stat.bError := TRUE;
            stat.sErrorText := CONCAT('High temperature limit exceeded at ', nott_temps.out_sHighestTempName);
            stat.sStatus := stat.sErrorText;
            stat.nState := E_NOTT_CRYO_WARMUP_STATE.STOP_WARMUP;

        ELSIF bAllWarm THEN
            stat.nState := E_NOTT_CRYO_WARMUP_STATE.WARM_TEMPERATURE_ACHIEVED;
            stat.sStatus := 'Warm temperature achieved';

        ELSE
            stat.sStatus := 'Warming up...';
        END_IF;


    E_NOTT_CRYO_WARMUP_STATE.WARM_TEMPERATURE_ACHIEVED:

        IF in_bEnable THEN
            stat.sState  := 'WARM';
            stat.sStatus := 'Warm temperature achieved';

            out_bPermit_Evacuation_Stop := TRUE;
            out_bPermit_CoolDown        := TRUE;

            // Keep temperature control active at warm targets
        ELSE
            stat.nState := E_NOTT_CRYO_WARMUP_STATE.STOP_WARMUP;
        END_IF;


    E_NOTT_CRYO_WARMUP_STATE.STOP_WARMUP:

        out_bPermit_Evacuation_Stop := FALSE;
        out_bPermit_CoolDown        := FALSE;

        nott_heaters.h_detector.M_SetDisable();
        nott_heaters.h_detector_spare.M_SetDisable();
        nott_heaters.h_sidecar.M_SetDisable();
        nott_heaters.h_photonic_chip.M_SetDisable();
        nott_heaters.h_base_plate.M_SetDisable();
        nott_heaters.h_shield.M_SetDisable();

        nott_t_ctrls.tc_detector.M_SetDisable();
        nott_t_ctrls.tc_detector_spare.M_SetDisable();
        nott_t_ctrls.tc_sidecar.M_SetDisable();
        nott_t_ctrls.tc_photonic_chip.M_SetDisable();
        nott_t_ctrls.tc_base_plate.M_SetDisable();
        nott_t_ctrls.tc_shields.M_SetDisable();

        stat.bActive := FALSE;
        stat.sState  := 'OFF';
        stat.sStatus := 'Warm-up stopped';

        stat.nState := E_NOTT_CRYO_WARMUP_STATE.OFF;


ELSE
    stat.bError := TRUE;
    stat.sErrorText := 'Unknown warm-up state';
    stat.sStatus := stat.sErrorText;
    stat.nState := E_NOTT_CRYO_WARMUP_STATE.NONE;
END_CASE;

M_StateMachine := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateStatus" Id="{4c3a2c10-0338-4234-982c-50ac83d3b294}">
      <Declaration><![CDATA[METHOD M_UpdateStatus : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stat.bEnabled		:= in_bEnable;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>

<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_NOTT_CRYO_WARMUP" Id="{c841ca50-7c10-48b1-8f8f-07e19ec21aec}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_NOTT_CRYO_WARMUP
VAR_INPUT
	in_bEnable:	BOOL := FALSE;	// System active while in_bEnable is TRUE
	in_Cryo_Stat:	T_NOTT_CRYO_STAT;
END_VAR
VAR_OUTPUT
	out_bPermit_Evacuation_Stop:	BOOL := FALSE;
	out_bPermit_CoolDown:				BOOL := FALSE;
END_VAR
VAR_IN_OUT
	{attribute 'OPC.UA.DA' := '0'}
	nott_temps:						FB_NOTT_TEMPERATURES;
	{attribute 'OPC.UA.DA' := '0'}
	nott_heaters:					FB_NOTT_HEATERS;
	{attribute 'OPC.UA.DA' := '0'}
	nott_t_ctrls:      				FB_NOTT_TCTRLs;
	{attribute 'OPC.UA.DA' := '0'}
	nott_t_votes: 					FB_NOTT_VOTERS;
END_VAR
VAR
		
	{attribute 'TcHmiSymbol.Show'}	
	cfg:	T_NOTT_CRYO_WARMUP_CFG;
	{attribute 'TcHmiSymbol.Show'}
	ctrl:	T_NOTT_CRYO_WARMUP_CTRL;
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'TcHmiSymbol.Show'}
	stat:	T_NOTT_CRYO_WARMUP_STAT;
	
//
// Internals
//
	timer:	TON;
	trig:	R_TRIG;	// Start trigger
//

	{attribute 'TcHmiSymbol.Show'}
	bPermitStart:	BOOL := FALSE;
	{attribute 'TcHmiSymbol.Show'}
	bPermitStop:	BOOL := FALSE;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[M_Configure();
M_ExecuteControllers();
M_SafetyCheck();
M_StateMachine( 
	nott_temps  := nott_temps,
	nott_heaters := nott_heaters,
	nott_t_ctrls := nott_t_ctrls,
	nott_t_votes := nott_t_votes
);
M_UpdateStatus();]]></ST>
    </Implementation>

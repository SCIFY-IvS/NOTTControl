<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_NOTT_CRYO_CTRL" Id="{d6e60d4f-f8b6-4737-accb-80f00d84378d}" SpecialFunc="None">
    <Declaration><![CDATA[// NOTT Cryogenic Controller
FUNCTION_BLOCK FB_NOTT_CRYO_CTRL
VAR_INPUT
	in_sName:	STRING := 'NOTT_CRYO_CTRL';	// Control System name
END_VAR
VAR

	///////////////////////////
	// Configuration parameters
	///////////////////////////
	cfg:	T_NOTT_CRYO_CFG;
	
	/////////////////////
	// Control parameters
	/////////////////////
	{attribute 'TcHmiSymbol.Show'}
	ctrl:	T_NOTT_CRYO_CTRL;

	/////////////////////
	// Status parameters
	/////////////////////
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'OPC.UA.DA.Access' := '1'}
	{attribute 'TcHmiSymbol.Show'}
	stat:	T_NOTT_CRYO_STAT;

	/////////////////////
	// Debug parameters
	/////////////////////
	debug:	T_NOTT_CRYO_DEBUG;

	/////////////////////
	// System Triggers
	/////////////////////
	triggers:	T_NOTT_CRYO_TRIGGERS;

	/////////////////////
	// System Events
	/////////////////////
	events:	T_NOTT_CRYO_EVENTS;

	/////////////////////
	// Local variables
	/////////////////////
	bCoolDownPermitEvacuationStop:	BOOL := FALSE;
	bCoolDownPermitWarmUp:			BOOL := FALSE;
	bWarmUpPermitEvacuationStop:	BOOL := FALSE;
	bWarmUpPermitCoolDown:			BOOL := FALSE;


	//////////////////////////////////////////////
	//             Controllers
	//////////////////////////////////////////////
 	{attribute 'TcHmiSymbol.Show'}
 	cool_down:			FB_NOTT_CRYO_COOLDOWN;
	{attribute 'TcHmiSymbol.Show'}
 	warm_up:			FB_NOTT_CRYO_WARMUP;

	
	//
	// Heaters
	//
// 	{attribute 'TcHmiSymbol.Show'}
// 	Heater_DetIF:		FB_PDS_CRYO_HEATER_CTRL;
// 	{attribute 'TcHmiSymbol.Show'}
// 	Heater_Preamp:		FB_PDS_CRYO_HEATER_CTRL;
// 	{attribute 'TcHmiSymbol.Show'}
// 	Heater_ColdPlate:	FB_PDS_CRYO_HEATER_CTRL;
// 	
// 	//
// 	// Pointers to System Overrides for control and sensors.
// 	// See M_Configure() for pointer assignments.
// 	//
// 	// Pointers to Overrides of Enable commands for valves, pumps and coolers.
	ptrArr_cor:	ARRAY [0..7] OF POINTER TO FB_CRYO_CMD_OVERRIDE;
	// Pointers to Overrides of Simulation flags for Temperatures.
// 	// Must match indexes of ptrArr_Temp[], see below.
	ptrArr_tor:	ARRAY [0..8] OF POINTER TO FB_CRYO_CMD_OVERRIDE;
// 	// Pointers to Overrides of Simulation flags for Pressures.
	ptrArr_por:	ARRAY [0..1] OF POINTER TO FB_CRYO_CMD_OVERRIDE;
// 	
// 	//
// 	// Indexes for Override GUIs.
// 	//
	guiIndex_cor:	UINT := 0;	// Index for Command Override Engineering GUI
	guiIndex_tor:	UINT := 0;	// Index for Temperature Override Engineering GUI
	guiIndex_por:	UINT := 0;	// Index for Pressure Override Engineering GUI
// 	
// 
	//////////////////////////////////////////////
	//             Subsystems
	//////////////////////////////////////////////

	//
	// Evacuation Subsystem control
	//
	{attribute 'TcHmiSymbol.Show'}
	evac:			FB_NOTT_CRYO_EVAC;	// PDS Evacuation Subsystem
	
	

	//////////////////////////////////////////////
	//             Sensors
	//////////////////////////////////////////////
	// Cryostat Pressure sensors
	sensor_VAGC:	FB_CRYO_SENSOR_PRESSURE;	// Cryo pressure gauge VAGC
	VAGC:			FB_CRYO_PRESSURE_VOTE;		// Cryo pressure C
	
		// Cryostat High Pressure sensor
	sensor_HPG:	FB_CRYO_SENSOR_PRESSURE;	// Cryo pressure gauge VAGC
	HPG:			FB_CRYO_PRESSURE_VOTE;		// Cryo pressure C

	///////////////////////////////////////////////////////
	//                  Temperatures
	///////////////////////////////////////////////////////
 
	{attribute 'OPC.UA.DA' := '1'}
	{attribute 'TcHmiSymbol.Show'}
 	nott_temp:				FB_NOTT_TEMPERATURES;  // All temperature sensors

	
	    /////////////////////////////////////////////////////////
	////                  Voters
	/////////////////////////////////////////////////////////
	{attribute 'OPC.UA.DA' := '1'}
		{attribute 'TcHmiSymbol.Show'}
    nott_voters : FB_NOTT_VOTERS; // All METIS voters

	/////////////////////////////////////////////////////////
	////                  Temperature control
	/////////////////////////////////////////////////////////
	{attribute 'OPC.UA.DA' := '1'}
		{attribute 'TcHmiSymbol.Show'}
// 	nott_tctrl:              FB_NOTT_TCTRL; // All temperature control loops
    
    /////////////////////////////////////////////////////////
	////                  Heaters
	/////////////////////////////////////////////////////////
	{attribute 'OPC.UA.DA' := '1'}
		{attribute 'TcHmiSymbol.Show'}
 	nott_heaters:			FB_NOTT_HEATERS; // All METIS heaters

	/////////////////////////////////////////////////////////
	////                  Temperature control
	/////////////////////////////////////////////////////////
	{attribute 'OPC.UA.DA' := '1'}
		{attribute 'TcHmiSymbol.Show'}
	nott_tctrl:              FB_NOTT_TCTRLs; // All temperature control loops




// 	Temp_Ambient:		FB_CRYO_TEMPERATURE;	// Ambient temperature
// 
// 	Temp_DetMon:		FB_CRYO_TEMPERATURE;	// DET Temperature measured with PT100
// 	Temp_ColdPlate:		FB_CRYO_TEMPERATURE;
// 	Temp_WarmFlange:	FB_CRYO_TEMPERATURE;
// 	Temp_WarmOptics:	FB_CRYO_TEMPERATURE;
// 	// Temperature assigned from the Lakeshore LS336
// 	// using FB_CRYO_TEMPERATURE::M_GetTemperatureFromLakeshore().
// 	// Do not map any signal of this instance.
// 	// See M_ExecuteControllers() for assignment.
// 	Temp_LS336:			FB_CRYO_TEMPERATURE;	
// 
// 
// 	//
// 	// Pointers to Temperatures.
// 	// Must match indexes of ptrArr_tor[], see above.
// 	//
	ptrArr_Temp:	ARRAY [0..8] OF POINTER TO FB_CRYO_TEMPERATURE;
// 	// Pointers to Pressures.
	ptrArr_Press:	ARRAY [0..1] OF POINTER TO FB_CRYO_PRESSURE_VOTE;
// 	
// 	//
// 	// System triggers
// 	//	
	{attribute 'OPC.UA.DA' := '0'}
	trgCool:			R_TRIG;
	{attribute 'OPC.UA.DA' := '0'}
	trgCoolStop:		F_TRIG;
	{attribute 'OPC.UA.DA' := '0'}
	trgWarmup:			R_TRIG;
	{attribute 'OPC.UA.DA' := '0'}
	trgWarmupStop:		F_TRIG;
	{attribute 'OPC.UA.DA' := '0'}
	trgEvacOn:			R_TRIG;
	{attribute 'OPC.UA.DA' := '0'}
	trgEvacOff:			F_TRIG;

	{attribute 'OPC.UA.DA' := '0'}
	timer:		TON;		// Timer for commands
	
	
	//
	//	Input signals
	//	
	
	
	//
	// Dummy values for simulation, etc.
	//
	// Dummy OP state for mapping of simulated devices.
	q_nStateDummy	AT%Q*:	UINT := 8;		

// 	// HMI Parameters
	hmi_pump_tmp: FB_HMI_CRYO_PUMP;
	hmi_pump_pvp: FB_HMI_CRYO_PUMP;
	hmi_valve_pvv1: FB_HMI_CRYO_VALVE;
	hmi_cooler: FB_HMI_CRYO_HELIUM_COMPRESSOR;
	
	
// 	hmi_lakeshore : FB_HMI_CRYO_LAKESHORE;
// 	hmi_heater_DetIF : FB_HMI_PDS_CRYO_HEATER;
// 	hmi_heater_Preamp : FB_HMI_PDS_CRYO_HEATER;
// 	hmi_heater_ColdPlate : FB_HMI_PDS_CRYO_HEATER;
	hmi_pressure_vote_vagc : FB_HMI_CRYO_PRESSURE_VOTE;
	hmi_pressure_vote_vag1 : FB_HMI_CRYO_PRESSURE_VOTE;
	hmi_pressure_vote_hpg : FB_HMI_CRYO_PRESSURE_VOTE;
// 
// 	hmi_heater_DetIF_temp : FB_HMI_CRYO_TEMPERATURE;
// 	hmi_heater_Preamp_temp : FB_HMI_CRYO_TEMPERATURE;
// 	hmi_heater_Coldplate_temp : FB_HMI_CRYO_TEMPERATURE;

	// Alarm Handling
	fbEventAlarm    : ARRAY[0..2] OF FB_EventAlarm;
	arrAlarmState    : ARRAY[0..2] OF BOOL;
	
	// Cryo System logs
	logs:	FB_CRYO_FUNCTION_LOG;

	
	////////////////////
	//// HMI Screen /// 
	//////////////////

bHMISwitch     AT %I* : BOOL;   // Push button / switch
bHMIOutEnable  AT %Q* : BOOL;   // HMI power output;

END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Increment cycle counter
debug.nCycleCounter := debug.nCycleCounter + 1;

//Wait UNTIL the controller is configured.
IF NOT stat.bConfigured THEN
	M_Configure(); 
	RETURN;
END_IF


//
// Read Temperature and Pressure Sensors

M_ReadSensors();


//
// Check for sensor HW errors
//
// M_CheckForSensorErrors();



///////////////////
// System Operation
///////////////////

//
// Execute Controllers
//
M_ExecuteControllers();


//
// Update command permissions
//
M_SetCmdPermissions();


//
// Capture system commands
//
M_CheckForCommands();


//
// Perform a safety check
//
M_SafetyCheck();


//
// Check triggers and log events
//
M_ProcessTriggers();

M_ProcessHmi();

//
// Execute system state machine
//
M_StateMachine();

//
// Refresh permissions after state transitions
//
M_SetCmdPermissions();

//
// HMI Screen ON/OFF
//
M_HMI_Screen_Control();
]]></ST>
    </Implementation>
    <Method Name="M_CheckForCommands" Id="{b3c6e6aa-1586-4592-991a-74db9a8ffd5e}">
      <Declaration><![CDATA[METHOD M_CheckForCommands
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

// Capture Cooldown ON/OFF command
trgCool(CLK := ctrl.bEnable_CoolDown);
trgCoolStop(CLK := ctrl.bEnable_CoolDown);

IF trgCool.Q THEN
	IF cool_down.bPermitStart THEN
		ctrl.bExecute	:= TRUE;
		ctrl.nCommand	:= E_NOTT_CRYO_CTRL_CMD.COOL;
	ELSE
		ctrl.bEnable_CoolDown	:= FALSE;
		logs.M_LogInfo('Cooldown start command rejected: permission denied.');
	END_IF

ELSIF trgCoolStop.Q THEN
	IF cool_down.bPermitStop THEN
		logs.M_LogInfo('Cooldown stop command accepted.');
	ELSE
		// Do not force ctrl.bEnable_CoolDown back to TRUE here.
		// The state machine also writes this bit internally.
		logs.M_LogInfo('Cooldown stop command not permitted.');
	END_IF
END_IF

// Capture Evacuation ON/OFF trigger
trgEvacOn(CLK := ctrl.bEnable_Evac);
trgEvacOff(CLK := ctrl.bEnable_Evac);

IF trgEvacOn.Q THEN
	IF evac.bPermitStart THEN
		ctrl.bEnable_Evac := TRUE;
		logs.M_LogInfo('Evacuation started.');
	ELSE
		ctrl.bEnable_Evac := FALSE;
		logs.M_LogInfo('Evacuation start command rejected: permission denied.');
	END_IF

ELSIF trgEvacOff.Q THEN
	IF evac.bPermitStop THEN
		ctrl.bEnable_Evac := FALSE;
		logs.M_LogInfo('Evacuation stopped.');
	ELSE
		// Do not force ctrl.bEnable_Evac back to TRUE here.
		logs.M_LogInfo('Evacuation stop command not permitted.');
	END_IF
END_IF


// Capture Evacuation ON/OFF trigger
trgEvacOn(CLK := ctrl.bEnable_Evac);
trgEvacOff(CLK := ctrl.bEnable_Evac);

IF trgEvacOn.Q THEN
	IF evac.bPermitStart THEN
		ctrl.bEnable_Evac := TRUE;
		logs.M_LogInfo('Evacuation started.');
	ELSE
		ctrl.bEnable_Evac := FALSE;
		logs.M_LogInfo('Evacuation start command rejected: permission denied.');
	END_IF

ELSIF trgEvacOff.Q THEN
	IF evac.bPermitStop THEN
		ctrl.bEnable_Evac := FALSE;
		logs.M_LogInfo('Evacuation stopped.');
	ELSE
		// Do not force ctrl.bEnable_Evac back to TRUE here.
		logs.M_LogInfo('Evacuation stop command not permitted.');
	END_IF
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_CheckForSensorErrors" Id="{e147f220-db5d-4e17-bd45-ee5f80f6f4b1}">
      <Declaration><![CDATA[METHOD M_CheckForSensorErrors
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Don't do any checks on startup.

IF stat.nState = E_NOTT_CRYO_CTRL_STATE.NONE	THEN
	RETURN;
END_IF


////////////////////////////////////////////////
// Check for errors by testing the 'Valid' flag.
////////////////////////////////////////////////
IF	NOT VAGC.stat.bValid	THEN
	stat.bError	:= TRUE;
	stat.sState	:= 'Cryo Vacuum gauge problem';
	IF stat.nState	<> E_NOTT_CRYO_CTRL_STATE.ERROR	THEN
		logs.M_LogInfo('ERROR State: VAGC gauge failure');
	END_IF
	stat.nState	:= E_NOTT_CRYO_CTRL_STATE.ERROR;

ELSE
	stat.bError	:= FALSE;
//	stat.sState	:= '';
END_IF


///////////////////////
// Check for Interlocks
///////////////////////
// TODO

//
// Evacuation and Repressurization are mutually exclusive.
//
// TODO


//
// Disable control in failure state
//
IF stat.bError THEN
	ctrl.bEnable_CoolDown 	:= FALSE;
	ctrl.bEnable_Warmup		:= FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_CheckLakeshoreCommand" Id="{be41b795-455d-4af3-b636-24f67650036d}">
      <Declaration><![CDATA[METHOD M_CheckLakeshoreCommand
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(* TODO

IF ctrl.bLS_UpdateSETP THEN
Reset trigger flag
	ctrl.bLS_UpdateSETP	:= FALSE;
	
Safety
	IF ctrl.lrLS_RAMP > 1.0 THEN
		ctrl.lrLS_RAMP	:= 1.0;
	ELSIF ctrl.lrLS_RAMP < 0.0 THEN
		ctrl.lrLS_RAMP	:= 0.0;
	END_IF
	
Set the mode
	IF ctrl.nLS_Mode <> E_CRYO_LAKESHORE_MODE.MONITORING THEN
		Lakeshore.M_SetMode(ctrl.nLS_Mode);
	ELSE
		RETURN;	// Nothing to do
	END_IF
ELSE
	RETURN;	// Nothing to do
END_IF




CASE ctrl.nLS_Mode OF
	E_CRYO_LAKESHORE_MODE.MONITORING,
	E_CRYO_LAKESHORE_MODE.COOLING,
	E_CRYO_LAKESHORE_MODE.WARMUP,
	E_CRYO_LAKESHORE_MODE.COOLING_UPDATE,
	E_CRYO_LAKESHORE_MODE.WARMUP_UPDATE:
		Lakeshore.M_SetMode(E_CRYO_LAKESHORE_MODE.MONITORING);	// No action
		
	E_CRYO_LAKESHORE_MODE.SINGLE_SETUP:
		IF stat.nState = E_CRYO_CTRL_STATE.COLD THEN
			Lakeshore.M_SetParams(
				in_nPID_A_P			:= cfg.LS_W_PID_A_P, 
				in_nPID_A_I			:= cfg.LS_W_PID_A_I, 
				in_nPID_A_D			:= cfg.LS_W_PID_A_D, 
				in_nHeater_Range	:= cfg.LS_W_Heater_Range, 
				in_lrCtrlRamp		:= ctrl.lrLS_RAMP, 
				in_lrSetpoint_A		:= ctrl.lrLS_SETP);
		END_IF
	ELSE
		Lakeshore.M_SetMode(E_CRYO_LAKESHORE_MODE.MONITORING);	// No action
END_CASE
*)
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_CheckVacuum" Id="{333e79aa-fbce-4e80-8799-8adf627b68b6}">
      <Declaration><![CDATA[// Method to check status of the cryostat vacuum.
// TODO: The limits might depend on the temperature.
METHOD M_CheckVacuum
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF VAGC.stat.bValid  THEN
	IF VAGC.stat.lrPressure < cfg.lrPress_GoodVac THEN
		stat.bVacuum	:= TRUE;
		stat.bVacuumOK:= TRUE;
	ELSIF VAGC.stat.lrPressure < cfg.lrPress_InVac THEN
		stat.bVacuum	:= TRUE;
		stat.bVacuumOK:= FALSE;
	ELSE
		stat.bVacuum	:= FALSE;
		stat.bVacuumOK:= FALSE;
	END_IF 
ELSE
	stat.bVacuum	:= FALSE;
	stat.bVacuumOK:= FALSE;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_Configure" Id="{6b1ff45b-ac29-46b7-bfed-5c22653d648f}">
      <Declaration><![CDATA[METHOD M_Configure
VAR_INPUT
END_VAR
VAR
	refBOOL:	REFERENCE TO BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stat.bConfigured THEN
	RETURN;
ELSIF debug.nCycleCounter = 1 THEN
// THIS call just configures logs AT the very start.
// Logging is done by explicit calls to M_LogInfo().
	logs(in_sName := in_sName);
	

	// Set pointers to Pressure readings
	ptrArr_Press[0] := ADR(VAGC);	
	ptrArr_Press[1] := ADR(evac.VAG1);	

	
// Set pointers to Overrides of Simulation flags for Pressures.
	ptrArr_por[0] := ADR(ctrl.por_VAGC);
	ptrArr_por[1] := ADR(evac.ctrl.por_VAG1);
	
ELSIF debug.nCycleCounter = 2 THEN
// Initialize events
	events.info.CreateEx		(TC_EVENTS.NottCryoSysEventClass.Info,0);
	events.warning.CreateEx		(TC_EVENTS.NottCryoSysEventClass.Warning,0);
	events.error.CreateEx		(TC_EVENTS.NottCryoSysEventClass.Error,FALSE,0);
	events.critical.CreateEx	(TC_EVENTS.NottCryoSysEventClass.Critical,TRUE,0);
	
ELSIF debug.nCycleCounter = 3 THEN
	
	
// Pressure Simulation flags
	ctrl.bSim_Press_VAGC		:= FALSE;	// The values will come from the simulator.
	//evac.ctrl.bSim_Press_VAG1	:= FALSE;	// The values will come from the simulator.
	//refBOOL	REF=evac.ctrl.bSim_Press_VAG1;	refBOOL	:= TRUE;

ELSIF debug.nCycleCounter > 200 THEN
	stat.bConfigured	:= TRUE;
ELSE
	RETURN;
END_IF


]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ExecuteControllers" Id="{ecd9afa5-738c-4753-b62d-612a0c867fca}">
      <Declaration><![CDATA[METHOD M_ExecuteControllers
VAR
	ptrSimTemp:	POINTER TO LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
nott_tctrl(temperatures := nott_temp);

nott_heaters(tctrl := nott_tctrl);


// //
// // Controllers, i.e. LN2 cooler, Heater, ...
// //
// 
// // Evacuation subsystem
ctrl.cor_Evac(in_bEnable:=ctrl.bEnable_Evac);
evac(	in_bEnable	:= ctrl.cor_Evac.out_bEnable, 
		in_RefVAGC	:= VAGC);	

ctrl.cor_CoolDown(in_bEnable:=ctrl.bEnable_CoolDown);
cool_down(
	in_bEnable:= ctrl.cor_CoolDown.out_bEnable, 
	out_bPermit_Evacuation_Stop=> bCoolDownPermitEvacuationStop, 
	out_bPermit_WarmUp=> bCoolDownPermitWarmUp, 
	nott_temps:= nott_temp, 
	nott_heaters:= nott_heaters, 
	nott_t_ctrls:= nott_tctrl, 
	nott_t_votes:= nott_voters);

ctrl.cor_WarmUp(in_bEnable:=ctrl.bEnable_WarmUp);
warm_up(
	in_bEnable:= ctrl.cor_WarmUp.out_bEnable, 
	out_bPermit_Evacuation_Stop=> bWarmUpPermitEvacuationStop, 
	out_bPermit_CoolDown=> bWarmUpPermitCoolDown, 
	nott_temps:= nott_temp, 
	nott_heaters:= nott_heaters, 
	nott_t_ctrls:= nott_tctrl, 
	nott_t_votes:= nott_voters);


//
// All temperatures are known.
// Select the Master temperature
//
M_GetMasterTemp();


//
// Get the lowest temperature in the cryostat
//	
M_GetLowestTemperature();

//
// Get the highest temperature in the cryostat
//	
M_GetHighestTemperature();
	


	]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GetHighestTemperature" Id="{f099693e-d874-48c5-b3ed-d3d7c79c242b}">
      <Declaration><![CDATA[METHOD M_GetHighestTemperature
VAR_INPUT
END_VAR
VAR
	lrTempK:	LREAL	:= 0.0;	// The lowest possible temperature
	bValid:		BOOL	:= FALSE;
	i:			INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

stat.lrHighestTempK		:= nott_temp.out_lrHighestTemp;
stat.bHighestTempValid	:= nott_temp.out_bHighestTempValid;

	
		
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GetLowestTemperature" Id="{bf361e98-30dd-4e82-9d81-54c9087f08fa}">
      <Declaration><![CDATA[METHOD M_GetLowestTemperature
VAR_INPUT
END_VAR
VAR
	lrTempK:	LREAL	:= 850.0;	// Highest possible temperature
	bValid:		BOOL	:= FALSE;
	i:			INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[

stat.lrLowestTempK		:= nott_temp.out_lrLowestTemp;
stat.bLowestTempValid	:= nott_temp.out_bLowestTempValid;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GetMasterTemp" Id="{9f658211-f955-49ef-a8cf-c1aa3c505951}">
      <Declaration><![CDATA[//
// By default,  master temperature is the one from Heater_DetIF.
// However, if this sensor fails, the system will select another
// sensor in the following order:
//  - Lakeshore
//  - Temp_DetMon
//
METHOD M_GetMasterTemp
VAR_INPUT
END_VAR
VAR
	lrDetectorTempK:	LREAL := 9999.0;
	bDetectorTempValid:	BOOL := FALSE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
// Use nott_temp directly for cryostat temperature status estimation.
// COLD means the detector is below the warm threshold. Prefer the detector
// vote and fall back to individual detector sensors only if the vote is invalid.
// OP means the highest included cryostat temperature is below the operational
// threshold.

IF nott_temp.t_detector_vote.stat.bValid THEN
	lrDetectorTempK		:= nott_temp.t_detector_vote.stat.lrTempK;
	bDetectorTempValid	:= TRUE;
ELSIF nott_temp.t_detector.stat.bValid THEN
	lrDetectorTempK		:= nott_temp.t_detector.stat.lrTempK;
	bDetectorTempValid	:= TRUE;
ELSIF nott_temp.t_detector_spare.stat.bValid THEN
	lrDetectorTempK		:= nott_temp.t_detector_spare.stat.lrTempK;
	bDetectorTempValid	:= TRUE;
END_IF

IF bDetectorTempValid THEN
	stat.bCold	:= lrDetectorTempK < cfg.lrTemp_Warm;
ELSE
	stat.bCold	:= FALSE;
END_IF

IF nott_temp.out_bHighestTempValid THEN
	stat.bOP	:= nott_temp.out_lrHighestTemp < cfg.lrTemp_OP;
ELSE
	stat.bOP	:= FALSE;
END_IF
RETURN;


]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_GetState" Id="{5a884a9e-ba07-433e-b2f1-a9a097b44b59}">
      <Declaration><![CDATA[METHOD M_GetState
VAR_INPUT
END_VAR
VAR_INST
	timer:		TON;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Determine the initial state based on the command and actuator state.

// Firstly wait for the complete system to start.
// Serial port devices need about seven seconds to initialise.
// We wait 10 sec to avoid going into Error state on startup.
//
IF NOT stat.bSystemStarted	THEN
	// Start the 10s timer
	timer(IN:=FALSE);
	timer(IN:=TRUE, PT:=T#10S);
	stat.bSystemStarted	:= TRUE;
	stat.sState	:= 'Starting...';
	RETURN;
END_IF

timer();

IF timer.Q	THEN
	timer(IN:=FALSE);	// Reset the timer
	
	// 10S have expired.
	// Find the system state from the combined thermal and pressure statuses.
	// If temperature or pressure status cannot be estimated, the logic falls
	// through to WARM_PRESS as the conservative startup state.
	IF stat.bOP OR stat.bCold	THEN
		logs.M_LogInfo('On restart, System is COLD.');
		// Turn ON the Cool-Down 
		ctrl.bEnable_CoolDown	:= TRUE;
		// Enable Evacuation
		ctrl.bEnable_Evac	:= TRUE;
		//Disable WarmUp
		ctrl.bEnable_WarmUp := FALSE;
		// Log
		logs.M_LogInfo('System started in state COLD');
		// Switch to Cold state.
		stat.nState	:= E_NOTT_CRYO_CTRL_STATE.COLD;
		
	ELSIF stat.bVacuumOK OR stat.bVacuum THEN
		// Enable Evacuation
		ctrl.bEnable_Evac		:= TRUE;
		// Stop Cooler.
		ctrl.bEnable_CoolDown	:= FALSE;
		// Turn OFF the heaters.
		ctrl.bEnable_WarmUp	:= FALSE;
		// Log
		logs.M_LogInfo('System started in state WARM_VACUUM');

		// The system is in WARM_VACUUM.
		stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_VACUUM;		
		
	ELSE
		// Stop Evacuation.
		ctrl.bEnable_Evac			:= FALSE;
		// Stop Cooler.
		ctrl.bEnable_CoolDown		:= FALSE;
		// Turn OFF the heaters.
		ctrl.bEnable_WarmUp			:= FALSE;
		logs.M_LogInfo('System started in state WARM_PRESS');

		// The system is in WARM_PRESS.
		stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_PRESS;
	END_IF	
ELSE
	stat.sState	:= 'Starting...';
END_IF

// // Determine the initial state based on the command and actuator state.
// 
// // Firstly wait for the complete system to start.
// // Serial port devices need about seven seconds to initialise.
// // We wait 10 sec to avoid going into Error state on startup.
// //
// IF NOT stat.bSystemStarted	THEN
// 	// Start the 10s timer
// 	timer(IN:=FALSE);
// 	timer(IN:=TRUE, PT:=T#10S);
// 	stat.bSystemStarted	:= TRUE;
// 	stat.sState	:= 'Starting...';
// 	RETURN;
// END_IF
// 
// timer();
// 
// IF timer.Q	THEN
// 	timer(IN:=FALSE);	// Reset the timer
// 	
// 	// 10S have expired.
// 	// Find the system state based of sensor eadings.
// 	IF nott_temp.t_detector_vote.stat.lrTempK <= cfg.lrTemp_Cold	THEN
// 		logs.M_LogInfo('On restart, System is COLD.');
// 		// Turn ON the Cool-Down 
// 		ctrl.bEnable_CoolDown	:= TRUE;
// 		// Enable Evacuation
// 		ctrl.bEnable_Evac	:= TRUE;
// 		//Disable WarmUp
// 		ctrl.bEnable_WarmUp := FALSE;
// 		// Log
// 		logs.M_LogInfo('System started in state COLD');
// 		// Switch to Cold state.
// 		stat.nState	:= E_NOTT_CRYO_CTRL_STATE.COLD;
// 		
// 	ELSIF 	nott_temp.t_detector_vote.stat.lrTempK > cfg.lrTemp_Cold	AND 
// 			VAGC.stat.lrPressure <= cfg.lrPress_InVac				THEN
// 		// Enable Evacuation
// 		ctrl.bEnable_Evac		:= TRUE;
// 		// Stop Cooler.
// 		ctrl.bEnable_CoolDown	:= FALSE;
// 		// Turn OFF the heaters.
// 		ctrl.bEnable_WarmUp	:= FALSE;
// 		// Log
// 		logs.M_LogInfo('System started in state WARM_VACUUM');
// 
// 		// The system is in WARM_VACUUM.
// 		stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_VACUUM;		
// 		
// 	ELSIF 	nott_temp.t_detector_vote.stat.lrTempK > cfg.lrTemp_Cold	AND 
// 			VAGC.stat.lrPressure > cfg.lrPress_InVac				THEN
// 		// Stop Evacuation.
// 		ctrl.bEnable_Evac	:= FALSE;
// 		// Stop Cooler.
// 		ctrl.bEnable_CoolDown		:= FALSE;
// 		// Turn OFF the heaters.
// 		ctrl.bEnable_WarmUp	:= FALSE;
// 		logs.M_LogInfo('System started in state WARM_PRESS');
// 
// 		// The system is in WARM_PRESS.
// 		stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_PRESS;
// 	ELSE
// // Stop Evacuation.
// 		ctrl.bEnable_Evac			:= FALSE;
// // Stop Cooler.
// 		ctrl.bEnable_CoolDown		:= FALSE;
// // Turn OFF the heaters.
// 		ctrl.bEnable_WarmUp			:= FALSE;
// 		logs.M_LogInfo('System started in state WARM_PRESS');
// 
// // The system is in WARM_PRESS.
// 		stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_PRESS;
// 	END_IF	
// ELSE
// 	stat.sState	:= 'Starting...';
// END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_HMI_Screen_Control" Id="{45acb9a9-844b-46fb-8751-2c8819581c4f}">
      <Declaration><![CDATA[METHOD M_HMI_Screen_Control : BOOL
VAR_INPUT
END_VAR
VAR_INST
    trigHMISwitch : R_TRIG;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_HMI_Screen_Control := TRUE;

////////////////////
/// HMI Screen   ///
////////////////////

// Rising edge detection
trigHMISwitch(CLK := bHMISwitch);

// Toggle HMI power output
IF trigHMISwitch.Q THEN
    bHMIOutEnable := NOT bHMIOutEnable;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ProcessHmi" Id="{e3cb379d-3813-454d-a3fb-346b114f3b4b}">
      <Declaration><![CDATA[METHOD PRIVATE M_ProcessHmi]]></Declaration>
      <Implementation>
        <ST><![CDATA[hmi_pump_tmp(
	inout_sPumpStatRef := evac.pump_tmp.stat,
	inout_sCmdOver := evac.ctrl.cor_TMP,
	inout_fbAlarmHandlerRef := evac.pump_tmp.fbAlarmHandler
	);

hmi_pump_pvp(
	inout_sPumpStatRef := evac.pump_pvp.stat,
	inout_sCmdOver := evac.ctrl.cor_PVP,
	inout_fbAlarmHandlerRef := evac.pump_pvp.fbAlarmHandler
	);

hmi_valve_pvv1(
	inout_sValveStatRef := evac.PVV1.stat,
	inout_sCmdOver := evac.ctrl.cor_PVV1,
	inout_fbAlarmHandlerRef := evac.PVV1.fbAlarmHandler,
	);
	
hmi_cooler(inout_sCpaStatRef:= cool_down.cooler.stat, inout_sCmdOver:= cool_down.ctrl.cor_Cooler, out_stat=> );


hmi_pressure_vote_vagc(
	inout_sPressureVoteStatRef := VAGC.stat,
	inout_sCmdOver := ctrl.por_VAGC,
	inout_fbAlarmHandlerRef := VAGC.fbAlarmHandler
	);

hmi_pressure_vote_vag1(
	inout_sPressureVoteStatRef := evac.VAG1.stat,
	inout_sCmdOver := evac.ctrl.por_VAG1,
	inout_fbAlarmHandlerRef := evac.VAG1.fbAlarmHandler
	);
hmi_pressure_vote_hpg(
	inout_sPressureVoteStatRef := HPG.stat,
	inout_sCmdOver := ctrl.por_HPG,
	inout_fbAlarmHandlerRef := HPG.fbAlarmHandler
	);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ProcessTriggers" Id="{926bb19b-2599-4262-b7c1-df02cad83bab}">
      <Declaration><![CDATA[METHOD M_ProcessTriggers
VAR_INPUT
END_VAR
VAR
    fbFormat:	FB_FormatString;
	sOut:		STRING;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//
// Check triggers and log corresponding events.
//

//
// Cooler
//
// triggers.Cooler_Enable		(CLK := cooler.in_bEnable);
// triggers.Cooler_Disable		(CLK := cooler.in_bEnable);
// triggers.Cooler_ON			(CLK := (cooler.stat.nDevState = E_CRYO_CRYOTELGT_STATE.ON));
// triggers.Cooler_OFF			(CLK := (cooler.stat.nDevState = E_CRYO_CRYOTELGT_STATE.OFF));
// 
// IF triggers.Cooler_Enable.Q	THEN
// 	logs.M_LogInfo('Cooler Starting...');
// ELSIF triggers.Cooler_Disable.Q	THEN
// 	logs.M_LogInfo('Cooler Stopping...');
// ELSIF triggers.Cooler_ON.Q	THEN
// 	logs.M_LogInfo('Cooler ON');
// ELSIF triggers.Cooler_OFF.Q	THEN
// 	logs.M_LogInfo('Cooler OFF');
// END_IF


//
// Pressure and Temperature status flags
//

// Vacuum
triggers.Vacuum_ON		(CLK := stat.bVacuum);
triggers.Vacuum_OFF		(CLK := stat.bVacuum);
triggers.Vacuum_OK		(CLK := stat.bVacuumOK);
triggers.Vacuum_NOT_OK	(CLK := stat.bVacuumOK);

IF triggers.Vacuum_ON.Q	THEN
	logs.M_LogInfo('In Vacuum');
ELSIF triggers.Vacuum_OFF.Q	THEN
	logs.M_LogInfo('NOT In Vacuum');
ELSIF triggers.Vacuum_OK.Q	THEN
	logs.M_LogInfo('Vacuum OK');
ELSIF triggers.Vacuum_NOT_OK.Q	THEN
	logs.M_LogInfo('Vacuum NOT OK');
END_IF


// Temperature
triggers.Cold_ON		(CLK := stat.bCold);
triggers.Cold_OFF		(CLK := stat.bCold);
triggers.OP_ON			(CLK := stat.bOP);
triggers.OP_OFF			(CLK := stat.bOP);

IF triggers.Cold_ON.Q	THEN
	logs.M_LogInfo('System is COLD');
ELSIF triggers.Cold_OFF.Q	THEN
	logs.M_LogInfo('System is NOT COLD');
ELSIF triggers.OP_ON.Q	THEN
	logs.M_LogInfo('System is OPERATIONAL');
ELSIF triggers.OP_OFF.Q	THEN
	logs.M_LogInfo('System is NOT OPERATIONAL');
END_IF


	
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ReadSensors" Id="{672cff29-2690-4702-a7ba-5d0f0ce7deac}">
      <Declaration><![CDATA[METHOD M_ReadSensors
VAR_INPUT
END_VAR
VAR
	refBOOL:	REFERENCE TO BOOL;
	refLREAL:	REFERENCE TO LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//
// Read system temperatures.
//

nott_temp();

// Update the voters
nott_voters(nott_temp := nott_temp);


// NOTT Cryostat pressure.

// Sensor instance
// Average over 1 sec (1000 ms).
sensor_VAGC(
	in_sName := 'VAGC_S1',
	in_nType		:= E_CRYO_SENSOR_TYPE_PRESS.PKR_360,	
	in_nSampleTime	:= 1000);

// VAGC Pressure Voting system (one sensor only!)
ctrl.por_VAGC(in_bEnable := ctrl.bSim_Press_VAGC);
VAGC(
	in_sName := 'VAGC',
	in_bSimulation	:= ctrl.por_VAGC.out_bEnable,
// In reality, there is only one pressure sensor connected (sensor_VAGC)
	in_nNumSensor	:= 2,	
	in_nVoteMethod	:= E_CRYO_VOTE.V_1oo2,
	in_pSensor1		:= ADR(sensor_VAGC));
	
sensor_HPG(
	in_sName := 'HPG_S1',
	in_nType		:= E_CRYO_SENSOR_TYPE_PRESS.CMR_361,	
	in_nSampleTime	:= 1000);

//VAGC Pressure Voting system (one sensor only!)
ctrl.por_HPG(in_bEnable := ctrl.bSim_Press_HPG);
HPG(
	in_sName := 'HPG',
	in_bSimulation	:= ctrl.por_HPG.out_bEnable,
// In reality, there is only one pressure sensor connected (sensor_VAGC)
	in_nNumSensor	:= 2,	
	in_nVoteMethod	:= E_CRYO_VOTE.V_1oo2,
	in_pSensor1		:= ADR(sensor_HPG));


//
// Check Vacuum in the system
//	
M_CheckVacuum();
]]></ST>
      </Implementation>
    </Method>

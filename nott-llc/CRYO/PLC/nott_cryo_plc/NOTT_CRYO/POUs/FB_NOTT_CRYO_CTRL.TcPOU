    <Method Name="M_SetCmdPermissions" Id="{168e9b73-fc4a-42e0-8906-762b91e47017}">
      <Declaration><![CDATA[METHOD M_SetCmdPermissions : BOOL
VAR_INPUT
END_VAR
VAR
	bPermitStartEvacuation:	BOOL := FALSE;
	bPermitStopEvacuation:	BOOL := FALSE;
	bPermitStartCoolDown:	BOOL := FALSE;
	bPermitStopCoolDown:	BOOL := FALSE;
	bPermitStartWarmUp:	BOOL := FALSE;
	bPermitStopWarmUp:	BOOL := FALSE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_SetCmdPermissions := FALSE;

// Start from a fail-closed permission set. Then open the allowed HMI
// actions according to the top-level physical state and active routine.
IF warm_up.stat.bActive THEN
	// Warmup active
	bPermitStartEvacuation	:= TRUE;
	bPermitStopEvacuation	:= FALSE;
	bPermitStartCoolDown	:= FALSE;
	bPermitStopCoolDown		:= FALSE;
	bPermitStartWarmUp		:= TRUE;
	bPermitStopWarmUp		:= TRUE;

ELSIF cool_down.stat.bActive THEN
	// Cooldown active
	bPermitStartEvacuation	:= TRUE;
	bPermitStopEvacuation	:= FALSE;
	bPermitStartCoolDown	:= TRUE;
	bPermitStopCoolDown		:= TRUE;
	bPermitStartWarmUp		:= FALSE;
	bPermitStopWarmUp		:= FALSE;

ELSIF stat.bOP THEN
	// Operational
	bPermitStartEvacuation	:= TRUE;
	bPermitStopEvacuation	:= TRUE;
	bPermitStartCoolDown	:= TRUE;
	bPermitStopCoolDown		:= TRUE;
	bPermitStartWarmUp		:= TRUE;
	bPermitStopWarmUp		:= TRUE;

// ELSIF stat.bCold THEN
// 	// Cold but not operational
// 	bPermitStartEvacuation	:= TRUE;
// 	bPermitStopEvacuation	:= FALSE;
// 	bPermitStartCoolDown	:= TRUE;
// 	bPermitStopCoolDown		:= TRUE;
// 	bPermitStartWarmUp		:= FALSE;
// 	bPermitStopWarmUp		:= FALSE;

ELSIF stat.bCold THEN
    // Cold but not operational
    bPermitStartEvacuation := TRUE;
    bPermitStopEvacuation  := FALSE;
    bPermitStartCoolDown   := TRUE;
    bPermitStopCoolDown    := TRUE;
    bPermitStartWarmUp     := TRUE;  // Change from FALSE
    bPermitStopWarmUp      := FALSE;

ELSIF evac.bEvacuationActive THEN
	// Evacuating
	bPermitStartEvacuation	:= TRUE;
	bPermitStopEvacuation	:= TRUE;
	bPermitStartCoolDown	:= TRUE;
	bPermitStopCoolDown		:= FALSE;
	bPermitStartWarmUp		:= FALSE;
	bPermitStopWarmUp		:= FALSE;

ELSIF stat.bVacuumOK OR stat.bVacuum THEN
	// Warm vacuum or good vacuum
	bPermitStartEvacuation	:= TRUE;
	bPermitStopEvacuation	:= TRUE;
	bPermitStartCoolDown	:= TRUE;
	bPermitStopCoolDown		:= FALSE;
	bPermitStartWarmUp		:= FALSE;
	bPermitStopWarmUp		:= FALSE;

ELSE
	// Warm pressurized
	bPermitStartEvacuation	:= TRUE;
	bPermitStopEvacuation	:= FALSE;
	bPermitStartCoolDown	:= FALSE;
	bPermitStopCoolDown		:= FALSE;
	bPermitStartWarmUp		:= FALSE;
	bPermitStopWarmUp		:= FALSE;
END_IF

// Cross-routine vetoes. The routine-specific state machines know when a
// dependent command is safe from their local process state.
bPermitStopEvacuation	:= bPermitStopEvacuation
	AND bCoolDownPermitEvacuationStop
	AND bWarmUpPermitEvacuationStop;
bPermitStartCoolDown	:= bPermitStartCoolDown AND bWarmUpPermitCoolDown;
bPermitStartWarmUp		:= bPermitStartWarmUp AND bCoolDownPermitWarmUp;

evac.M_PermitStart_Evacuation(in_bPermissionStart := bPermitStartEvacuation);
evac.M_PermitStop_Evacuation(in_bPermissionStop := bPermitStopEvacuation);

cool_down.M_PermitStart_Cooldown(in_bPermissionStart := bPermitStartCoolDown);
cool_down.M_PermitStop_Cooldown(in_bPermissionStop := bPermitStopCoolDown);

warm_up.M_PermitStart_WarmUp(in_bPermissionStart := bPermitStartWarmUp);
warm_up.M_PermitStop_WarmUp(in_bPermissionStop := bPermitStopWarmUp);

ctrl.bSafe_Cooling	:= bPermitStartCoolDown;
ctrl.bSafe_Warmup	:= bPermitStartWarmUp;

M_SetCmdPermissions := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SetStatus" Id="{f025e401-b414-44ce-9499-c12078610b3c}">
      <Declaration><![CDATA[METHOD M_SetStatus
VAR_INPUT
	nState:	E_NOTT_CRYO_CTRL_STATE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
CASE nState OF
	
	E_NOTT_CRYO_CTRL_STATE.NONE:
	stat.bDone	:= TRUE;
	stat.bBusy	:= FALSE;
	stat.bError	:= FALSE;
	stat.bActive:= FALSE;
	stat.sState	:= 'OFF';
	
	E_NOTT_CRYO_CTRL_STATE.WARM_PRESS:
	stat.bDone	:= TRUE;
	stat.bBusy	:= FALSE;
	stat.bError	:= FALSE;
	stat.bActive:= TRUE;
	stat.sState	:= 'WARM - PRESSURIZED';
	
	E_NOTT_CRYO_CTRL_STATE.WARM_VACUUM:
	stat.bDone	:= TRUE;
	stat.bBusy	:= FALSE;
	stat.bError	:= FALSE;
	stat.bActive:= TRUE;
	stat.sState	:= 'WARM - VACUUM';
	

	E_NOTT_CRYO_CTRL_STATE.COOLING_DOWN:
	stat.bDone	:= FALSE;
	stat.bBusy	:= TRUE;
	stat.bError	:= FALSE;
	stat.bActive:= TRUE;
	stat.sState	:= 'COOLING DOWN...';

	E_NOTT_CRYO_CTRL_STATE.COLD:
	stat.bDone	:= TRUE;
	stat.bBusy	:= FALSE;
	stat.bError	:= FALSE;
	stat.bActive:= TRUE;
	stat.sState	:= 'COLD';

	E_NOTT_CRYO_CTRL_STATE.WARMING_UP:
	stat.bDone	:= FALSE;
	stat.bBusy	:= TRUE;
	stat.bError	:= FALSE;
	stat.bActive:= TRUE;
	stat.sState	:= 'WARMING UP...';
	
	// TODO
	// Select reference temperature for warmup
	//
	(*
	IF Temp_Mirror.stat.lrTempK >= cfg.lrTemp_Warm	THEN
		stat.sState	:= 'WARM';
	ELSIF	Temp_Mirror.stat.lrTempK < cfg.lrTemp_Warm AND
			Temp_Mirror.stat.lrTempK >= cfg.lrTemp_Precooled	THEN
		stat.sState	:= 'WARMING UP... PRE-COOLED';
	ELSE
		stat.sState	:= 'WARMING UP... COLD';
	END_IF
	*)

	
	E_NOTT_CRYO_CTRL_STATE.ERROR:
	stat.bDone	:= TRUE;
	stat.bBusy	:= FALSE;
	stat.bError	:= TRUE;
	stat.bActive:= FALSE;
	stat.sState	:= 'ERROR';

END_CASE

]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SIM_Cooler" Id="{09433411-2c0e-4aeb-89e1-a57a3a561dab}">
      <Declaration><![CDATA[METHOD M_SIM_Cooler
VAR_INPUT
END_VAR
VAR
	refCoolerStat:	REFERENCE TO T_CRYO_CRYOTELGT_STAT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// // Simulated values
// refCoolerStat	REF=cooler.stat;
// refCoolerStat.nErrorCode	:= 0;
// refCoolerStat.lrTempReject	:= 21.4;
// // Simulated temperature close to DET I/F temperature.
// refCoolerStat.lrTempColdHead:= Heater_DetIF.Temp.stat.lrTempK - 0.1;
// IF cooler.in_bEnable	THEN
// 	refCoolerStat.bActive	:= TRUE;
// 	refCoolerStat.nDevState	:= E_CRYO_CRYOTELGT_STATE.ON;
// ELSE
// 	refCoolerStat.bActive	:= FALSE;
// 	refCoolerStat.nDevState	:= E_CRYO_CRYOTELGT_STATE.OFF;
// END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_StateMachine" Id="{f7bc139f-316a-4d67-87a9-8a35421cffa4}">
      <Declaration><![CDATA[METHOD M_StateMachine
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[////////////////
// State Machine
////////////////
CASE stat.nState OF
	/////////////////////////////////
	E_NOTT_CRYO_CTRL_STATE.NONE:
	/////////////////////////////////
	//
	// This is the state on power-up.
	// Determine the initial state based on the command and actuator state.
	M_GetState();	
	RETURN;
	

	/////////////////////////////////
	E_NOTT_CRYO_CTRL_STATE.WARM_PRESS:
	/////////////////////////////////
	//
	
	ctrl.bEnable_CoolDown := FALSE;
	ctrl.bEnable_WarmUp   := FALSE;
	
	// Reject any queued top-level sequence command in WARM_PRESS.
	// Evacuation is not handled through ctrl.bExecute / ctrl.nCommand.
	IF ctrl.bExecute THEN
		stat.nLastCommand := ctrl.nCommand;
		ctrl.bExecute     := FALSE;
		ctrl.nCommand     := E_NOTT_CRYO_CTRL_CMD.NONE;
	
		CASE stat.nLastCommand OF
			E_NOTT_CRYO_CTRL_CMD.COOL:
				logs.M_LogInfo('COOL command rejected: system is WARM_PRESS. Evacuate first.');
	
			E_NOTT_CRYO_CTRL_CMD.WARM_UP:
				logs.M_LogInfo('WARM_UP command rejected: system is already warm pressurized.');
		ELSE
				logs.M_LogInfo('Command rejected: system is WARM_PRESS.');
		END_CASE
	END_IF
	
	// Evacuation itself is not part of this state machine.
	// Once pressure status says the cryostat is in vacuum, recover to WARM_VACUUM.
	IF stat.bVacuumOK OR stat.bVacuum THEN
		ctrl.bEnable_CoolDown := FALSE;
		ctrl.bEnable_WarmUp   := FALSE;
	
		logs.M_LogInfo('Vacuum detected. State is WARM_VACUUM.');
		stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_VACUUM;
	END_IF
	
	M_SetStatus(stat.nState);
	RETURN;
	
	
	//////////////////////////////////////////
	E_NOTT_CRYO_CTRL_STATE.WARM_VACUUM:
	//////////////////////////////////////////
	//
		
		// Keep warmup inactive unless a permitted WARM_UP command is accepted.
		ctrl.bEnable_WarmUp := FALSE;
		
		// If the system is already cold/operational, recover to COLD.
		IF stat.bOP OR stat.bCold THEN
			ctrl.bEnable_Evac := TRUE;
		
			logs.M_LogInfo('Cold condition detected. State is COLD.');
			stat.nState := E_NOTT_CRYO_CTRL_STATE.COLD;
		
		// If vacuum is lost, return to WARM_PRESS.
		ELSIF NOT (stat.bVacuumOK OR stat.bVacuum) THEN
			ctrl.bEnable_CoolDown := FALSE;
			ctrl.bEnable_WarmUp   := FALSE;
		
			logs.M_LogInfo('Vacuum lost. State is WARM_PRESS.');
			stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_PRESS;
		
		// Process queued top-level commands.
		ELSIF ctrl.bExecute THEN
			ctrl.bExecute     := FALSE;
			stat.nLastCommand := ctrl.nCommand;
			ctrl.nCommand     := E_NOTT_CRYO_CTRL_CMD.NONE;
		
			CASE stat.nLastCommand OF
		
				E_NOTT_CRYO_CTRL_CMD.COOL:
					// Cool down only if top-level permissions and cooler state allow it.
					IF cool_down.bPermitStart AND cool_down.cooler.stat.bInitialised THEN
						logs.M_LogInfo('Cool-down started.');
		
						ctrl.bEnable_Evac     := TRUE;
						ctrl.bEnable_CoolDown := TRUE;
						ctrl.bEnable_WarmUp   := FALSE;
		
						stat.nState := E_NOTT_CRYO_CTRL_STATE.COOLING_DOWN;
					ELSIF NOT cool_down.bPermitStart THEN
						ctrl.bEnable_CoolDown := FALSE;
						logs.M_LogInfo('COOL command rejected: cooldown start not permitted.');
					ELSE
						ctrl.bEnable_CoolDown := FALSE;
						logs.M_LogInfo('COOL command rejected: cooler not initialised.');
					END_IF
		
				E_NOTT_CRYO_CTRL_CMD.WARM_UP:
					// Normally not allowed in WARM_VACUUM by the current permission table.
					IF warm_up.bPermitStart THEN
						logs.M_LogInfo('Warm-up started.');
		
						ctrl.bEnable_Evac     := TRUE;
						ctrl.bEnable_WarmUp   := TRUE;
						ctrl.bEnable_CoolDown := FALSE;
		
						stat.nState := E_NOTT_CRYO_CTRL_STATE.WARMING_UP;
					ELSE
						ctrl.bEnable_WarmUp := FALSE;
						logs.M_LogInfo('WARM_UP command rejected: warmup start not permitted in WARM_VACUUM.');
					END_IF
		
			ELSE
				logs.M_LogInfo('Command rejected: unsupported command in WARM_VACUUM.');
			END_CASE
		END_IF
		
		M_SetStatus(stat.nState);
		RETURN;
	

	///////////////////////////////////
	E_NOTT_CRYO_CTRL_STATE.COOLING_DOWN:
	///////////////////////////////////
	//
	
	// Evacuation should remain enabled during cooldown.
	ctrl.bEnable_Evac := TRUE;
	
	// Reject queued top-level sequence commands while cooldown is active.
	// Stop cooldown via ctrl.bEnable_CoolDown FALSE and permission logic.
	IF ctrl.bExecute THEN
		stat.nLastCommand := ctrl.nCommand;
		ctrl.bExecute     := FALSE;
		ctrl.nCommand     := E_NOTT_CRYO_CTRL_CMD.NONE;
	
		CASE stat.nLastCommand OF
			E_NOTT_CRYO_CTRL_CMD.COOL:
				logs.M_LogInfo('COOL command ignored: cooldown already active.');
	
			E_NOTT_CRYO_CTRL_CMD.WARM_UP:
				logs.M_LogInfo('WARM_UP command rejected: cooldown active.');
		ELSE
				logs.M_LogInfo('Command rejected: cooldown active.');
		END_CASE
	END_IF
	
	// Operational or cold condition reached.
	IF stat.bOP OR stat.bCold THEN
		ctrl.bEnable_Evac := TRUE;
	
		logs.M_LogInfo('Cold/operational condition reached. State is COLD.');
		stat.nState := E_NOTT_CRYO_CTRL_STATE.COLD;
	
	// Vacuum lost during cooldown.
	ELSIF NOT (stat.bVacuumOK OR stat.bVacuum) THEN
		ctrl.bEnable_CoolDown := FALSE;
		ctrl.bEnable_WarmUp   := FALSE;
	
		logs.M_LogInfo('Vacuum lost during cooldown. State is WARM_PRESS.');
		stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_PRESS;
	
	// Cooldown stopped by command/permission.
	ELSIF NOT ctrl.bEnable_CoolDown THEN
		ctrl.bEnable_WarmUp := FALSE;
	
		IF stat.bVacuumOK OR stat.bVacuum THEN
			logs.M_LogInfo('Cooldown stopped. State is WARM_VACUUM.');
			stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_VACUUM;
		ELSE
			logs.M_LogInfo('Cooldown stopped and vacuum not present. State is WARM_PRESS.');
			stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_PRESS;
		END_IF
	
	// Cooler/routine no longer active unexpectedly.
	ELSIF NOT cool_down.cooler.stat.bActive THEN
		ctrl.bEnable_CoolDown := FALSE;
		ctrl.bEnable_WarmUp   := FALSE;
	
		IF stat.bVacuumOK OR stat.bVacuum THEN
			logs.M_LogInfo('Cooler inactive. State is WARM_VACUUM.');
			stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_VACUUM;
		ELSE
			logs.M_LogInfo('Cooler inactive and vacuum not present. State is WARM_PRESS.');
			stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_PRESS;
		END_IF
	END_IF
	
	M_SetStatus(stat.nState);
	RETURN;
	
	
	///////////////////////////////////////////
	E_NOTT_CRYO_CTRL_STATE.COLD:
	///////////////////////////////////////////
		
		// Keep evacuation enabled/available while cold.
		ctrl.bEnable_Evac := TRUE;
		
		// If the cryostat is no longer cold or operational, return to the appropriate warm state.
		IF NOT (stat.bOP OR stat.bCold) THEN
			ctrl.bEnable_WarmUp := FALSE;
		
			IF stat.bVacuumOK OR stat.bVacuum THEN
				logs.M_LogInfo('Cryostat no longer cold. State is WARM_VACUUM.');
				stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_VACUUM;
			ELSE
				ctrl.bEnable_CoolDown := FALSE;
				logs.M_LogInfo('Cryostat no longer cold and vacuum not present. State is WARM_PRESS.');
				stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_PRESS;
			END_IF
		
		// Process queued top-level commands.
		ELSIF ctrl.bExecute THEN
			ctrl.bExecute     := FALSE;
			stat.nLastCommand := ctrl.nCommand;
			ctrl.nCommand     := E_NOTT_CRYO_CTRL_CMD.NONE;
		
			CASE stat.nLastCommand OF
		
				E_NOTT_CRYO_CTRL_CMD.WARM_UP:
					IF warm_up.bPermitStart THEN
						logs.M_LogInfo('Warm-up started.');
		
						ctrl.bEnable_Evac     := TRUE;
						ctrl.bEnable_WarmUp   := TRUE;
						ctrl.bEnable_CoolDown := FALSE;
		
						stat.nState := E_NOTT_CRYO_CTRL_STATE.WARMING_UP;
					ELSE
						ctrl.bEnable_WarmUp := FALSE;
						logs.M_LogInfo('WARM_UP command rejected: warmup start not permitted in COLD.');
					END_IF
		
				E_NOTT_CRYO_CTRL_CMD.COOL:
					// Already cold. Cooling command is only useful if cooldown is not active
					// and permissions allow it.
					IF cool_down.bPermitStart AND cool_down.cooler.stat.bInitialised THEN
						logs.M_LogInfo('Cooldown command accepted in COLD: maintaining cold state.');
		
						ctrl.bEnable_Evac     := TRUE;
						ctrl.bEnable_CoolDown := TRUE;
						ctrl.bEnable_WarmUp   := FALSE;
					ELSE
						logs.M_LogInfo('COOL command ignored/rejected: system is already COLD or cooldown not permitted.');
					END_IF
		
			ELSE
				logs.M_LogInfo('Command rejected: unsupported command in COLD.');
			END_CASE
		
		// If cooldown was requested but the cooler is not active, clear the cooldown enable.
		ELSIF ctrl.bEnable_CoolDown AND NOT cool_down.cooler.stat.bActive THEN
			ctrl.bEnable_CoolDown := FALSE;
			logs.M_LogInfo('Cooldown enable cleared in COLD: cooler inactive.');
		END_IF
		
		M_SetStatus(stat.nState);
		RETURN;
	
	/////////////////////////////////
	E_NOTT_CRYO_CTRL_STATE.WARMING_UP:
	/////////////////////////////////
	//
	// Warmup routine is active or expected to be active.
	// Permissions are handled centrally in M_SetCmdPermissions().
	//
	
	// Cooldown must remain disabled during warmup.
	ctrl.bEnable_CoolDown := FALSE;
	
	// Evacuation should remain enabled/available during warmup.
	ctrl.bEnable_Evac := TRUE;
	
	// Reject queued top-level sequence commands while warmup is active.
	// Stop warmup via ctrl.bEnable_WarmUp FALSE and permission logic.
	IF ctrl.bExecute THEN
		stat.nLastCommand := ctrl.nCommand;
		ctrl.bExecute     := FALSE;
		ctrl.nCommand     := E_NOTT_CRYO_CTRL_CMD.NONE;
	
		CASE stat.nLastCommand OF
			E_NOTT_CRYO_CTRL_CMD.WARM_UP:
				logs.M_LogInfo('WARM_UP command ignored: warmup already active.');
	
			E_NOTT_CRYO_CTRL_CMD.COOL:
				logs.M_LogInfo('COOL command rejected: warmup active.');
		ELSE
				logs.M_LogInfo('Command rejected: warmup active.');
		END_CASE
	END_IF
	
	// Warmup stopped by command/permission.
	IF NOT ctrl.bEnable_WarmUp THEN
		ctrl.bEnable_CoolDown := FALSE;
	
		IF stat.bOP OR stat.bCold THEN
			// Warmup was interrupted while still cold.
			ctrl.bEnable_Evac   := TRUE;
			ctrl.bEnable_WarmUp := FALSE;
	
			logs.M_LogInfo('Warmup stopped while cryostat is still cold. State is COLD.');
			stat.nState := E_NOTT_CRYO_CTRL_STATE.COLD;
	
		ELSIF stat.bVacuumOK OR stat.bVacuum THEN
			ctrl.bEnable_WarmUp := FALSE;
	
			logs.M_LogInfo('Warmup stopped. State is WARM_VACUUM.');
			stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_VACUUM;
	
		ELSE
			ctrl.bEnable_Evac   := FALSE;
			ctrl.bEnable_WarmUp := FALSE;
	
			logs.M_LogInfo('Warmup stopped and vacuum not present. State is WARM_PRESS.');
			stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_PRESS;
		END_IF
	
	// Warmup routine reports no longer active. Treat as complete/stopped and classify by physical state.
	ELSIF NOT warm_up.stat.bActive THEN
		ctrl.bEnable_WarmUp   := FALSE;
		ctrl.bEnable_CoolDown := FALSE;
	
		IF stat.bOP OR stat.bCold THEN
			ctrl.bEnable_Evac := TRUE;
	
			logs.M_LogInfo('Warmup routine inactive while cryostat is still cold. State is COLD.');
			stat.nState := E_NOTT_CRYO_CTRL_STATE.COLD;
	
		ELSIF stat.bVacuumOK OR stat.bVacuum THEN
			ctrl.bEnable_Evac := TRUE;
	
			logs.M_LogInfo('Warmup complete. State is WARM_VACUUM.');
			stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_VACUUM;
	
		ELSE
			ctrl.bEnable_Evac := FALSE;
	
			logs.M_LogInfo('Warmup complete. State is WARM_PRESS.');
			stat.nState := E_NOTT_CRYO_CTRL_STATE.WARM_PRESS;
		END_IF
	END_IF
	
	M_SetStatus(stat.nState);
	RETURN;
	
	
	/////////////////////////////////
	E_NOTT_CRYO_CTRL_STATE.ERROR:
	/////////////////////////////////
	//
	// Fault state.
	// Keep commands and process routines disabled.
	// Use RESET to restart state estimation through NONE.
	//
	
	// Clear pending top-level command.
	ctrl.bExecute := FALSE;
	ctrl.nCommand := E_NOTT_CRYO_CTRL_CMD.NONE;
	
	// Disable process enables.
	// Depending on the failure type, evacuation might eventually need special
	// handling, but for now keep this simple and conservative.
	ctrl.bEnable_CoolDown := FALSE;
	ctrl.bEnable_WarmUp   := FALSE;
	ctrl.bEnable_Evac     := FALSE;
	
	// Permissions are handled centrally in M_SetCmdPermissions().
	// If desired later, add explicit ERROR handling there to force all permits FALSE.
	
	IF ctrl.bReset THEN
		ctrl.bReset := FALSE;
	
		// Re-run startup/state estimation after reset.
		stat.bSystemStarted := FALSE;
		stat.bError         := FALSE;
		stat.nState         := E_NOTT_CRYO_CTRL_STATE.NONE;
	
		logs.M_LogInfo('ERROR reset requested. Restarting state estimation.');
	
		M_SetStatus(stat.nState);
	
	// auto-recovery.

	(*
	ELSIF NOT stat.bError THEN
		stat.bSystemStarted := FALSE;
		stat.nState := E_NOTT_CRYO_CTRL_STATE.NONE;
	
		logs.M_LogInfo('ERROR cleared. Restarting state estimation.');
	
		M_SetStatus(stat.nState);
	*)
	END_IF
	
	M_SetStatus(stat.nState);
	RETURN;

END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>